{
  "name": "md-viewer",
  "version": "1.0.0",
  "description": "Electron + TypeScript Markdown File Viewer",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --outfile=dist/renderer/index.js --platform=browser --target=chrome120 --format=iife",
    "build:preload": "esbuild src/renderer/preload.ts --bundle --outfile=dist/renderer/preload.js --platform=node --target=node18 --format=cjs --external:electron",
    "build": "npm run build:main && npm run build:renderer && npm run build:preload",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "highlight.js": "^11.9.0",
    "marked": "^11.1.0"
  }
}
